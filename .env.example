# Tori Wallet 환경 변수 설정
# 이 파일을 .env로 복사하고 값을 입력하세요

# WalletConnect Project ID (필수 - dApp 연결 기능 사용 시)
# https://cloud.walletconnect.com 에서 무료로 발급받으세요
WALLETCONNECT_PROJECT_ID=your_project_id_here

# 0x 키를 보관하고 /swap/allowance-holder/{quote,price}를 중계하는 서버 프록시 (운영 필수)
SWAP_API_BASE_URL=https://api.example.com
