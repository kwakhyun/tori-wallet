+'use strict';
+// Bound recursive AST walkers before recursion, including caller-supplied ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 256) throw new SyntaxError('Brace nesting limit exceeded');
+    if (node && node.nodes) for (const child of node.nodes) pending.push([child, depth + 1]);
+  }
+};
